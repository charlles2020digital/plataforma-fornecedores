# ═══════════════════════════════════════════════════════════
# ELITE Atacado Brasil — Variáveis de Ambiente
# Renomeie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env com dados reais no GitHub!
# ═══════════════════════════════════════════════════════════

# ─── N8N ──────────────────────────────────────────────────
# IP público ou domínio da sua VM Oracle Cloud
N8N_HOST=SEU_IP_ORACLE_AQUI
N8N_USER=admin
N8N_PASSWORD=SENHA_FORTE_AQUI

# ─── Meta WhatsApp Cloud API ───────────────────────────────
# Obtido em: developers.facebook.com → seu App → WhatsApp → API Setup
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
META_PHONE_NUMBER_ID=1234567890
# Token que você INVENTA para verificar o webhook (qualquer string)
META_VERIFY_TOKEN=elite-atacado-token-2025

# ─── Groq API ─────────────────────────────────────────────
# Obtido em: console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ─── Supabase ─────────────────────────────────────────────
# Obtido em: supabase.com → seu projeto → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGcixxxxxxxxxxxxxxxx

# ─── Hotmart ──────────────────────────────────────────────
# Link de compra do seu produto na Hotmart
HOTMART_LINK=https://pay.hotmart.com/XXXXXXXXXX
